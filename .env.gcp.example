# 각 VM에서 이 파일을 .env.gcp로 복사 후 Terraform 생성 값으로 교체

IMAGE_REGISTRY=asia-northeast3-docker.pkg.dev/YOUR_PROJECT_ID/hublink
IMAGE_TAG=latest
HUBLINK_ENV_FILE=.env.gcp

# Terraform 재실행 후 설정 파일 재작성 방지를 위한 고정 내부 IP
PLATFORM_VM_IP=10.10.0.10
DOMAIN_A_VM_IP=10.10.0.20
DOMAIN_B_VM_IP=10.10.0.30
DATA_VM_IP=10.10.0.40

DB_URL=jdbc:postgresql://10.10.0.40:5432/hublink
DB_USERNAME=hublink
DB_PASSWORD=CHANGE_ME

REDIS_HOST=10.10.0.40
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=10.10.0.40:9092

EUREKA_URL=http://10.10.0.10:19090/eureka/
CONFIG_SERVER_URL=http://10.10.0.10:19092

SWAGGER_GATEWAY_URL=http://10.10.0.10:19091
ZIPKIN_URL=http://10.10.0.40:9411/api/v2/spans

SLACK_ENABLED=false
SLACK_BOT_TOKEN=

AI_ENABLED=false
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
AI_API_KEY=

KAKAO_ENABLED=false
KAKAO_REST_API_KEY=

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
CORS_ALLOWED_ORIGIN=http://localhost:3000

LOG_LEVEL_ROOT=WARN
