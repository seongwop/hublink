# VM 자동 시작/종료 스케줄
vm_schedule_enabled   = true
vm_start_schedule     = "30 9 * * *"
vm_stop_schedule      = "0 3 * * *"
vm_schedule_time_zone = "Asia/Seoul"

# Compute Engine VM 자동 시작 대상
scheduled_vm_names = ["platform", "domain-a", "domain-b", "delivery", "data"]

# 플랫폼과 모니터링 통합 VM의 부팅 무결성 검증
secure_boot_vm_names = ["platform"]
