# terraform.tfvars 복사용 예시 파일

# GCP 콘솔에서 만든 프로젝트 ID
project_id = "YOUR_GCP_PROJECT_ID"

# HubLink 리소스 생성 리전과 존
region = "asia-northeast3"
zone   = "asia-northeast3-a"

# 리소스 이름 공통 접두어
name_prefix = "hublink"

# GitHub Actions OIDC 인증 허용 저장소
github_repository = "seongwop/hublink"

# SSH와 공개 서비스 포트 접근 허용 범위
ssh_source_ranges    = ["35.235.240.0/20"]
public_source_ranges = ["0.0.0.0/0"]

# 고정 외부 IP 대상 VM
external_ip_vm_names = ["platform", "monitoring", "load-test"]

# SSH 공개키 직접 등록 옵션
# ssh_username   = "hublink"
# ssh_public_key = "ssh-ed25519 AAAA..."

# 기본 VM 스펙 변경 옵션
