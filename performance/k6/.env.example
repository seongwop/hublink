# Gateway 기본 주소
BASE_URL=http://10.10.0.10:19091

# delivery-service 직접 호출 주소
DELIVERY_BASE_URL=http://10.10.0.70:19099

# 기본 헤더
USER_ROLE=MASTER
USER_ID=00000000-0000-0000-0000-000000000000

# 배송 생성 seed 값
SUPPLIER_COMPANY_ID=00000000-0000-0000-0000-000000000000
RECEIVER_COMPANY_ID=00000000-0000-0000-0000-000000000000
PRODUCT_ID=00000000-0000-0000-0000-000000000000
PRODUCT_NAME=k6-test-product
ORDER_QUANTITY=1
PRODUCT_QUANTITY=1
DEADLINE_HOURS=48

# AI Stream 선택 값
RECEIVER_SLACK_ID=U1234567890
DEADLINE_DAYS=3

# 인증 토큰 선택 값
# ACCESS_TOKEN=

# reset DB 연결 값
# 기본값 10.10.0.40:5432 / user / 0000 / hublink
# 다른 환경일 때만 override
# RESET_DB_HOST=10.10.0.40
# RESET_DB_PORT=5432
# RESET_DB_USER=user
# RESET_DB_PASSWORD=0000
# RESET_DB_NAME=hublink

# pre reset SQL
# 기본값으로 db/seed/11-reset-delivery-loadtest-baseline.sql 적용
# PRE_TEST_SQL_FILE=db/seed/11-reset-delivery-loadtest-baseline.sql

# post reset SQL
# 기본 비활성화, 필요 시만 명시
# POST_TEST_SQL_FILE=db/seed/11-reset-delivery-loadtest-baseline.sql

# 공통 부하 설정
SLEEP_SECONDS=1

# 부하 모델 선택
# VU 모드: vu, 고정 RPS 모드: rps
LOAD_MODEL=vu
# TARGET_RPS=40
# PRE_ALLOCATED_VUS=180
# MAX_VUS=250
# RPS_STAGES=[{"duration":"30s","target":40},{"duration":"3m","target":40}]
# GRACEFUL_STOP=30s

# Gateway 부록 대상 경로
PATHS=/actuator/health,/api/v1/orders

# ramping 시나리오 예시
# STAGES=[{"duration":"1m","target":30},{"duration":"3m","target":30},{"duration":"1m","target":0}]
